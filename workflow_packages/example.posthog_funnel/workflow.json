{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "example.posthog_funnel",
    "title": "Inspect a PostHog funnel",
    "description": "Explore event definitions and report one bounded funnel with reproducible queries and explicit data limitations.",
    "version": "1.0.1",
    "executor": "codex.procedure",
    "schedule_modes": [
      "on_demand"
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "posthog_project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "title": "PostHog project ID"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "title": "Funnel to investigate"
        },
        "start_date": {
          "type": "string",
          "format": "date",
          "title": "Start date (UTC, inclusive)",
          "maxLength": 10
        },
        "end_date": {
          "type": "string",
          "format": "date",
          "title": "End date (UTC, exclusive)",
          "maxLength": 10
        }
      },
      "required": [
        "project_id",
        "posthog_project_id",
        "question",
        "start_date",
        "end_date"
      ]
    },
    "integration_requirements": [
      {
        "provider_key": "custom.api.posthog",
        "capabilities": [
          "http.read",
          "http.write"
        ],
        "required": true
      }
    ],
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/posthog-funnel/SKILL.md",
        "skills/posthog-funnel/HOGQL.md"
      ],
      "entry_skill": "posthog-funnel",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 900
      },
      "services": {
        "analytics": {
          "provider_key": "custom.api.posthog",
          "max_calls": 8,
          "max_response_bytes": 32000
        }
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/POSTHOG_FUNNEL.md",
        "media_type": "text/markdown",
        "max_bytes": 32000
      }
    }
  }
}
